{
  "name": "@hyperttp/transport-deno",
  "version": "0.1.2",
  "description": "Native Deno HTTP transport for Hyperttp",
  "keywords": [
    "deno",
    "deno-runtime",
    "fetch",
    "http",
    "http-client",
    "hyperttp",
    "transport",
    "typescript"
  ],
  "license": "MIT",
  "author": "dirold2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IT-IF-OR/hyperttp-transport-deno.git"
  },
  "homepage": "https://github.com/IT-IF-OR/hyperttp-transport-deno#readme",
  "bugs": {
    "url": "https://github.com/IT-IF-OR/hyperttp-transport-deno/issues"
  },
  "files": [
    "dist/",
    "src/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "deno": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "node --input-type=module -e 'import { rmSync } from \"node:fs\"; rmSync(\"dist\", { recursive: true, force: true });'",
    "build": "tsc && esbuild \"dist/**/*.js\" --outdir=dist --allow-overwrite --minify --sourcemap && d-build",
    "pub": "d-publish",
    "dist": "d-dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:deno": "deno check src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:deno": "deno run --allow-net examples/smoke.ts",
    "check": "npm run typecheck && npm run typecheck:deno && npm test && npm run smoke:deno",
    "prepublishOnly": "npm run check",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@hyperttp/types": "^0.5.4",
    "@types/deno": "^2.7.0"
  },
  "devDependencies": {
    "@dirold2/dev-tools": "^1.1.3",
    "@hyperttp/types": "^0.5.4",
    "@types/deno": "^2.7.0",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
